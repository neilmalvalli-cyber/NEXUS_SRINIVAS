  "steps": [
    {
      "id": "baseline",
      "label": "Baseline (engine as of commit 7a1f536)",
      "files": [
        "01-baseline.json",
        "02-baseline-get-compaction.json"
      ],
      "changes": []
    },
    {
      "id": "B",
      "label": "B: writer lock split (wmu / mu)",
      "files": [
        "03-B-lock-split.json"
      ],
      "changes": [
        "readers no longer wait for the fsync of a commit or for the copy phase of compaction"
      ]
    },
    {
      "id": "B+C",
      "label": "B + C: read-handle pool",
      "files": [
        "04-BC-read-handles-first.json",
        "05-BC-read-handles-get.json"
      ],
      "changes": [
        "up to 4 extra read-only handles so parallel GETs do not serialize on one Windows file handle"
      ]
    },
    {
      "id": "A+B+C",
      "label": "A + B + C: group commit (final)",
      "files": [
        "06-ABC-group-commit.json",
        "07-final-ABC-full.json"
      ],
      "changes": [
        "concurrent commits queued while a commit is syncing are written as one frame with one fsync; each caller is acknowledged only after that fsync"
      ]
    }
  ],
