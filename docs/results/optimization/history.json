  "rejected": [
    {
      "name": "Packed index location (offset+size in one uint64)",
      "reason": "saves about 8 bytes per key but caps the file at about 8 TiB and changes no measured bottleneck; not done"
    },
    {
      "name": "Recovery read path",
      "reason": "already one sequential 4 MiB buffered scan at ~200–440 MB/s with 2 allocations per key (the key string and the map entry); no change made"
    },
    {
      "name": "Serialization (format) changes",
      "reason": "would change the on-disk format; the stable format is a hard requirement; none made"
    },
    {
      "name": "Delayed or timer-based group commit",
      "reason": "would add latency for a lone writer; group commit uses no timer"
    }
  ],
  "tradeoffs": [
    "Compaction under concurrent reads takes longer than baseline (readers now share the disk during the copy instead of being blocked); the longest reader stall fell from ~502 ms to ~35 ms.",
    "Group commit: commits merged into one frame become durable together or not at all; each caller still returns only after the fsync covering its operations."
  ],
